# Template for the published nginx manifest. It is rendered, never shipped:
# `apps/release.sh` fills every <…> from the tarballs it just built and checked,
# writes dist/apps/nginx.yaml, and refuses to continue if a single placeholder
# is left behind. An unfilled placeholder is an unfinished release, and the
# panel's loader rejects it anyway.
#
# Two shapes were possible and only one is honest: one manifest per
# architecture, or one manifest that lists both. A manifest carries the checksum
# of the bytes it points at, so a single flat sha256 cannot describe an amd64
# tarball and an arm64 tarball at once. Two files would give the store two cards
# for one app. Hence `artefacts`, one entry per architecture.
id: nginx
name: Nginx
version: <version>
build: <build>
runtime: systemd
summary: 静态编译的 nginx，由面板托管配置与站点
homepage: https://github.com/<org>/saopanel-apps
install:
  type: tarball
  artefacts:
<artefacts>
  # Mirrors list release directories, not files: the panel rewrites each one to
  # this host's artefact name, so one entry serves both architectures.
  mirrors:
<mirrors>
capabilities: [http_ssl, http_v2, realip, stub_status, gzip_static, stream]
services:
  - unit: saopanel-nginx
    ports: [80, 443]
uninstall:
  remove:
    - /var/lib/saopanel/apps/nginx/<version>-<build>
    - /etc/systemd/system/saopanel-nginx.service
  keep:
    - /var/lib/saopanel/site-conf
    - /var/www
    - /var/lib/saopanel/certs
