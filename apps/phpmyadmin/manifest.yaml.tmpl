# Template for the published phpMyAdmin manifest. It is rendered, never shipped:
# `apps/phpmyadmin/release.sh` fills every <…> from the tarballs it just built.
#
# kind: files — phpMyAdmin is bytes for nginx and php-fpm to serve, not a service
# of its own. That is why there is no runtime and no unit: nothing is started,
# and the port is the one its vhost listens on.
id: phpmyadmin
name: phpMyAdmin
version: <version>
build: <build>
kind: files
summary: MySQL/MariaDB 的 Web 管理界面，由面板的 nginx 与 PHP-FPM 提供
homepage: https://github.com/<org>/saopanel-apps
requires: [web-server, php83_fpm, mysql]
ports: [8081]
install:
  type: tarball
  artefacts:
<artefacts>
  # The one file that must differ per install: a blowfish secret generated here,
  # never shipped in the tarball.
  render:
    - from: conf/config.inc.php.tmpl
      to: config.inc.php
      mode: "0640"
      secrets:
        blowfish_secret: 32
  # Mirrors list release directories, not files: the panel rewrites each one to
  # this host's artefact name, so one entry serves both architectures.
  mirrors:
<mirrors>
capabilities: [phpmyadmin]
uninstall:
  remove:
    - "{prefix}"
  keep:
    - /opt/saopanel/www
    - /opt/saopanel/state/site-conf
    - /opt/saopanel/state/certs
